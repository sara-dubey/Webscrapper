    "rag:clear": "node scripts/clear_rag_chunks.mjs",
    "rag:reindex": "node scripts/reindex_rag_from_db_only.mjs",
    "rag:rebuild": "node scripts/clear_rag_chunks.mjs && node scripts/reindex_rag_from_db_only.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.2.5",
    "nodemailer": "^6.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^6.16.3",
    "supertest": "^7.1.1"
  }
}
